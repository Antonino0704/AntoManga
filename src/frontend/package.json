{
	"name": "frontend",
	"version": "8.0.3",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check \"build-only {@}\" --",
		"preview": "vite preview",
		"build-only": "vite build",
		"type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
		"lint": "eslint . --fix",
		"format": "prettier --write src/",
		"format-check": "prettier --check src/",
		"bump-version": "tsc -p src/tools/tsconfig.json && node src/tools/BumpVersion.js",
		"bumpedfrontend-check": "tsc -p src/tools/tsconfig.json && node src/tools/VersionCheck.js",
		"bumpedbackend-check": "tsc -p src/tools/tsconfig.json && node src/tools/VersionCheck.js"
	},
	"dependencies": {
		"bootstrap": "^5.3.2",
		"browser-image-compression": "^2.0.2",
		"pinia": "^4.0.3",
		"semver": "^7.8.5",
		"slugify": "^1.6.6",
		"vue": "^3.3.4",
		"vue-cookies": "^1.8.4",
		"vue-i18n": "^11.4.2",
		"vue-router": "^4.2.5"
	},
	"devDependencies": {
		"@actions/core": "^1.11.1",
		"@rushstack/eslint-patch": "^1.3.3",
		"@tsconfig/node18": "^18.2.2",
		"@types/node": "^22.20.5",
		"@types/semver": "^7.8.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.13.0",
		"eslint-plugin-vue": "^10.11.1",
		"npm-run-all2": "^9.0.4",
		"prettier": "^3.0.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vue-tsc": "^3.3.11"
	}
}